# ETAutomationsAPI ("eta") - example settings file
#
# Copy this file to ".env" in the folder you run eta from (or pass --env-file PATH to a command), then fill
# in the credentials of the services you use. Never commit or share .env: it holds passwords and API keys
# (.gitignore already ignores it). Full reference: spec/02-configuration.md and each service's spec.
#
# How the values are read (src/eta_automations/config.py):
# - Values in .env override variables already set in the operating system, as in the original tool.
# - An empty value (NAME=) counts as unset: the default applies, or the service stays unconfigured.
#   Because .env wins, delete a NAME= line if you set that variable in the operating system instead.
# - Lines starting with # are ignored. A commented-out line shows an optional setting with its default;
#   remove the leading "# " to change it.
# - Yes/no settings accept 1/true/yes/on or 0/false/no/off (any letter case).
# - A malformed value (for example a word where a number is expected) stops every command with a
#   configuration error (exit code 2) that names the variable, also for a service you do not use.
# - Keep comments on their own line. In an unquoted value " #" starts a comment, so wrap a value that
#   contains " #" in single quotes: VSHIP_PASSWORD='abc #1'. A "${NAME}" inside a value is expanded.
# - The program writes back to this file only QB_REFRESH_TOKEN (each rotated token) and, during
#   `eta qbo-auth`, QB_REALM_ID when it is empty. It never logs or prints a secret.


# =============================================================================================================
# Run settings (02 sec. 1)
# =============================================================================================================

# Folder for Send2Bindu.csv, Send2Ben.txt, Send2Accounting.txt, Failed_To_Process.txt, PotentialCustomsHold.txt,
# ToEmail_<run_id>.csv, reports/ and logs/. Default: the folder you run eta from.
# ETA_OUTPUT_DIR=

# Folder for tokens.json, ledger.jsonl, run.lock, probe/ and the e-mail state files; keep it outside any git
# repository. Default: %LOCALAPPDATA%\ETAutomationsAPI on Windows, else $XDG_STATE_HOME/eta_automations or
# ~/.local/state/eta_automations.
# ETA_STATE_DIR=

# Rows whose amount is below this go to Send2Bindu.csv (01 sec. 3); "$" and "," are allowed.
# ETA_MIN_INVOICE_AMOUNT=1000

# Notification window: an ETA up to this many US business days from now counts as "in window" (01 sec. 5).
# ETA_WINDOW_BUSINESS_DAYS=6

# If the VShip notification lookup fails: send = e-mail anyway (original behaviour), fail = Failed_To_Process.txt.
# ETA_ON_NOTIF_LOOKUP_ERROR=send

# Rows processed concurrently (`eta run --max-parallel N` overrides it for one run).
# ETA_MAX_PARALLEL_BOOKINGS=8

# Identical consecutive failures of one carrier before its remaining lookups are skipped (circuit breaker).
# ETA_CARRIER_FAILURE_LIMIT=5

# Console log level: DEBUG, INFO, WARNING, ERROR or CRITICAL (--log-level overrides it; the log file is always DEBUG).
# ETA_LOG_LEVEL=INFO

# Which client serves MSC rows: native (official API or myMSC token bridge, see MSC below), aggregator or off.
# ETA_PROVIDER_MSC=native

# Which client serves Maersk rows: native (Track & Trace Events API), aggregator or off.
# ETA_PROVIDER_MAERSK=native

# Which client serves CMA CGM rows: native (CMA tracking API), aggregator or off.
# ETA_PROVIDER_CMA=native

# Grimaldi has no public API: off or native keep the original "not yet implemented" message; aggregator tries ShipsGo.
# ETA_PROVIDER_GRIMALDI=off


# =============================================================================================================
# QuickBooks Online (04 sec. 3, 04b sec. 3) - required by `eta run`
# Keys: developer.intuit.com > your app > Keys & credentials (production keys for the real company; sandbox keys
# together with QB_SANDBOX=true).
# =============================================================================================================

# Intuit app Client ID (required).
QB_CLIENT_ID=

# Intuit app Client Secret (required).
QB_CLIENT_SECRET=

# QuickBooks company (realm) id (required); `eta qbo-auth` fills it in when it is empty.
QB_REALM_ID=

# OAuth refresh token: carry it over from the old .env or run `eta qbo-auth`; each rotated token is written back here.
QB_REFRESH_TOKEN=

# true = QuickBooks sandbox API host (with sandbox keys and realm); run the write and e-mail probes there first.
QB_SANDBOX=false

# Sent as minorversion on every call; 75 is the lowest minor version Intuit still honours.
# QB_MINOR_VERSION=75

# Name of the invoice custom field that holds the ETA (matched case-insensitively).
# QB_ETA_FIELD_NAME=ETA

# Hint only: the ETA field's DefinitionId as printed by `eta qbo-fields --invoice <DocNumber>` (no default).
QB_ETA_DEFINITION_ID=

# Field type used only when no invoice in the run shows it, e.g. DateType or StringType (`eta qbo-fields` prints it).
# QB_ETA_FIELD_TYPE=DateType

# strftime format of the ETA when the field turns out to be a StringType.
# QB_ETA_STRING_FORMAT=%m/%d/%Y

# Re-read every invoice after writing to confirm that the ETA and DocNumber were stored. Keep it on.
# QB_VERIFY_UPDATES=true

# Also request the enhanced custom fields (include=enhancedAllCustomFields) on update calls.
# QB_INCLUDE_ON_WRITES=true

# DocNumbers per "IN (...)" invoice query.
# QB_QUERY_CHUNK_SIZE=25

# Concurrent QuickBooks API calls.
# QB_MAX_CONCURRENCY=4

# Client-side limit, below Intuit's 500 requests per minute per company.
# QB_MAX_CALLS_PER_MINUTE=450

# Client-side limit, below Intuit's 10 requests per second per company and app.
# QB_MAX_CALLS_PER_SECOND=8

# Longest DocNumber QuickBooks accepts; a longer suffixed DocNumber ("X A", "X AA") is refused before any write.
# QB_DOCNUMBER_MAX_LEN=21

# Redirect URI for `eta qbo-auth`; it must be registered on the Intuit app (production requires https).
# QB_REDIRECT_URI=https://developer.intuit.com/v2/OAuth2Playground/RedirectUrl

# Space-separated OAuth scopes requested by `eta qbo-auth`.
# QB_OAUTH_SCOPES=com.intuit.quickbooks.accounting

# How invoice e-mails are sent: template_swap (QuickBooks /send with a temporarily swapped subject), graph or smtp.
# QB_EMAIL_STRATEGY=template_swap

# Refuse customer e-mails until `eta probe qbo --send-test` has recorded a verified test send. Keep it on.
# QB_EMAIL_REQUIRE_VERIFIED=true

# Shadow mode: deliver every invoice e-mail to this address instead of the customer (graph/smtp; see 04b sec. 3).
# QB_EMAIL_REDIRECT_TO=

# Inbox of the internal test customer "ETA Automation Test", used by `eta probe qbo --send-test`.
QB_TEST_SEND_TO=

# How Preferences are written during template_swap: full, or sparse (only after --prefs-roundtrip passes with it).
# QB_PREFS_UPDATE_MODE=full

# graph/smtp only: mark the invoice as sent in QuickBooks after the e-mail went out (best effort).
# QB_MARK_SENT=true

# graph/smtp only: e-mails per minute.
# QB_EMAIL_MAX_PER_MINUTE=25

# graph/smtp only: parallel sends (template_swap always sends one at a time).
# QB_EMAIL_MAX_CONCURRENCY=2


# =============================================================================================================
# Company-mailbox e-mail (04b sec. 3) - only for QB_EMAIL_STRATEGY=graph or smtp; not used by template_swap
# =============================================================================================================

# Sending mailbox (required for graph and smtp).
# EMAIL_FROM=invoices@example.com

# Reply-To address.
# EMAIL_REPLY_TO=

# Extra BCC recipients, comma-separated (for example an archive mailbox).
# EMAIL_BCC=

# Text file with the e-mail body; default: the QuickBooks invoice e-mail template message.
# EMAIL_BODY_TEMPLATE=

# Add the QuickBooks online-payment link when the invoice has one.
# EMAIL_INCLUDE_PAY_LINK=true

# Attach the invoice PDF downloaded from QuickBooks.
# EMAIL_ATTACH_PDF=true

# graph: directory (tenant) id of the Microsoft 365 app registration that has the Mail.Send permission.
# EMAIL_GRAPH_TENANT_ID=

# graph: application (client) id of that app registration.
# EMAIL_GRAPH_CLIENT_ID=

# graph: client secret of that app registration.
# EMAIL_GRAPH_CLIENT_SECRET=

# smtp: server host name.
# EMAIL_SMTP_HOST=

# smtp: server port.
# EMAIL_SMTP_PORT=587

# smtp: connection security: starttls, ssl or none.
# EMAIL_SMTP_SECURITY=starttls

# smtp: login user name.
# EMAIL_SMTP_USERNAME=

# smtp: login password (used exactly as typed).
# EMAIL_SMTP_PASSWORD=


# =============================================================================================================
# VShipCRM (05 sec. 3) - required by `eta run`
# =============================================================================================================

# VShipCRM user name (e-mail); also the default for MSC_USER_EMAIL.
VSHIP_USER_NAME=

# VShipCRM password (used exactly as typed).
VSHIP_PASSWORD=

# API root.
# VSHIP_API_BASE=https://vship2000-prod-api.azurewebsites.net/api

# Concurrent VShip API calls.
# VSHIP_MAX_CONCURRENCY=4

# Token lifetime in minutes to assume when the token carries no expiry.
# VSHIP_TOKEN_TTL_MINUTES=55

# commentType of the notes the program posts (1 = internal comment, as in the original).
# VSHIP_COMMENT_TYPE=1


# =============================================================================================================
# MSC (06 sec. 3). MSC_MODE=auto uses the official API when MSC_API_BASE_URL and MSC_API_SUBSCRIPTION_KEY are both
# set; otherwise the myMSC token bridge, which needs a token from your own signed-in browser (`eta msc-token`).
# =============================================================================================================

# auto, mymsc (token bridge) or api (official DCSA Track & Trace API).
# MSC_MODE=auto

# Official API base URL from MSC onboarding, e.g. https://<host>/dpo/trackandtrace/v2.2 (api mode).
MSC_API_BASE_URL=

# Official API subscription key, sent as the Ocp-Apim-Subscription-Key header (api mode).
MSC_API_SUBSCRIPTION_KEY=

# Official API calls per minute (0 = no limit; 5 on the Starter product).
# MSC_API_RATE_PER_MINUTE=0

# api mode: apply the approximated customs-hold rule (06 sec. 7.3); set false if `eta probe msc --compare` disagrees.
# MSC_API_CUSTOMS_HOLD_RULE=true

# Allow MSC's public mock sandbox as MSC_API_BASE_URL outside `eta probe msc --sandbox` (for tests only).
# MSC_ALLOW_SANDBOX=false

# Bridge token; optional, because `eta msc-token` stores one in tokens.json (a leading "Bearer " is removed).
# MSC_ACCESS_TOKEN=

# Value of the mymsc-user-email header; must equal your myMSC sign-in e-mail (default: VSHIP_USER_NAME).
# MSC_USER_EMAIL=

# Value of the mymsc-user-roles header.
# MSC_USER_ROLES=Customer

# myMSC GraphQL endpoint used by the token bridge.
# MSC_GRAPHQL_URL=https://services.mymsc.com/tracking/graphql

# Bridge-token lifetime in seconds to assume when the token shows no expiry.
# MSC_TOKEN_TTL_SECONDS=1800

# Token bridge: GraphQL calls per minute (0 = no limit).
# MSC_RATE_PER_MINUTE=120

# Rescue-only fallbacks of 06 sec. 7.5 (off for safety; rows that use them are flagged in the run report).
# MSC_RESCUE_FALLBACK=false

# Concurrent MSC calls.
# MSC_MAX_CONCURRENCY=4

# Read timeout in seconds (the connect timeout stays 10 s).
# MSC_TIMEOUT_SECONDS=30

# Legacy: used only as the last fallback for MSC_USER_EMAIL.
# MSC_USER_NAME=


# =============================================================================================================
# Maersk (07 sec. 3) - configured only when both credentials are set; the "Track & Trace Events" API product must be
# approved on your developer.maersk.com app.
# =============================================================================================================

# Consumer Key of the developer.maersk.com app (sent as the Consumer-Key header and as the OAuth client_id).
MAERSK_CLIENT_ID=

# App secret (used for the token request only).
MAERSK_CLIENT_SECRET=

# API gateway; https://api-stage.maersk.com only if Maersk provisions your app there.
# MAERSK_BASE_URL=https://api.maersk.com

# OAuth2 token endpoint.
# MAERSK_TOKEN_URL=https://api.maersk.com/customer-identity/oauth/v2/access_token

# Sent as the API-Version header (major version only) when set; leave it unset unless Maersk support asks.
# MAERSK_API_VERSION=

# final = arrival at the last location (the maersk.com "Arrives" date); pod = vessel arrival at the port of discharge.
# MAERSK_ETA_TARGET=final

# Which container decides on multi-container bookings: first (original behaviour) or latest.
# MAERSK_MULTI_CONTAINER_POLICY=first

# Truncate the ETA to its date (00:00 local time), like the dates maersk.com shows.
# MAERSK_ETA_DATE_ONLY=true

# Events per page (1-100).
# MAERSK_PAGE_LIMIT=100

# Safety cap on pages per booking.
# MAERSK_MAX_PAGES=10

# Concurrent Maersk calls.
# MAERSK_MAX_CONCURRENCY=3

# Events calls per minute (0 = no limit); set it only if HTTP 429 errors appear.
# MAERSK_RATE_PER_MINUTE=0

# Read timeout in seconds (the connect timeout stays 10 s).
# MAERSK_TIMEOUT_SECONDS=30


# =============================================================================================================
# CMA CGM (08 sec. 3) - configured with an API key (public tier, enough for the ETA) or an OAuth client id + secret.
# CMA bills every API call (200 and 404 answers too); `eta probe cma` makes 2 or more billable calls.
# =============================================================================================================

# API key ("keyId") from api-portal.cma-cgm.com > API Applications; sent as the KeyId header.
CMA_API_KEY=

# Private-tier OAuth2 client id (mailed by CMA after the contract); use it together with CMA_CLIENT_SECRET.
# CMA_CLIENT_ID=

# Private-tier OAuth2 client secret.
# CMA_CLIENT_SECRET=

# auto = oauth when the client id and secret are both set, else apikey; apikey or oauth force a mode.
# CMA_AUTH_MODE=auto

# Space-separated OAuth scopes.
# CMA_OAUTH_SCOPE=tandtcommercial:read:be tandtpublic:read:be

# OAuth2 token endpoint (https only).
# CMA_TOKEN_URL=https://auth.cma-cgm.com/as/token.oauth2

# API base (https only); change it only for a test URL given by CMA support.
# CMA_BASE_URL=https://apis.cma-cgm.net/operation/trackandtrace/v1

# reference = GET /events/{booking} (CMA's recommended way), dcsa_query = GET /events?carrierBookingReference=...
# CMA_LOOKUP_MODE=reference

# Events per page (1-500).
# CMA_PAGE_LIMIT=500

# Safety cap on pages per lookup.
# CMA_MAX_PAGES=10

# CMA partner code of the end customer; only for third parties, leave it empty for your own bookings.
# CMA_BEHALF_OF=

# Concurrent CMA calls.
# CMA_MAX_CONCURRENCY=2

# Proactive limit in calls per minute (unset = no limit); set it (e.g. 20) if HTTP 429 errors appear.
# CMA_MAX_CALLS_PER_MINUTE=

# Longest Retry-After in seconds the client waits out; a longer wait fails the lookup.
# CMA_MAX_RETRY_AFTER_S=120

# Read timeout in seconds (the connect timeout stays 10 s).
# CMA_TIMEOUT_S=30


# =============================================================================================================
# Optional tracking aggregator, ShipsGo API v2 (09 Part B). Enabled only when AGG_API_TOKEN is set, and used only
# for carriers set to ETA_PROVIDER_<CARRIER>=aggregator. Paid service: 1 credit per newly registered booking.
# =============================================================================================================

# ShipsGo API token of your company account.
# AGG_API_TOKEN=

# Backend; only shipsgo is implemented.
# AGG_PROVIDER=shipsgo

# ShipsGo API base URL.
# AGG_BASE_URL=https://api.shipsgo.com/v2

# Concurrent aggregator calls.
# AGG_MAX_CONCURRENCY=2

# Calls per minute (ShipsGo allows 100 per company).
# AGG_RATE_PER_MINUTE=90

# Read timeout in seconds.
# AGG_TIMEOUT_SECONDS=30

# Register untracked bookings with ShipsGo (1 credit each); false = only read bookings that are already tracked.
# AGG_ALLOW_CREATE=true

# Credit safety valve: at most this many new registrations per run.
# AGG_MAX_CREATES_PER_RUN=100

# Seconds a lookup waits for data on a freshly registered booking (0 = no wait).
# AGG_FIRST_LOOKUP_WAIT_S=45

# Seconds between polls while waiting.
# AGG_POLL_INTERVAL_S=15

# Bookings first seen less than this many minutes ago count as fresh (worth waiting for).
# AGG_FRESH_MINUTES=30

# Carrier code (SCAC) of MSC at ShipsGo.
# AGG_SCAC_MSC=MSCU

# Carrier code (SCAC) of Maersk at ShipsGo.
# AGG_SCAC_MAERSK=MAEU

# Carrier code (SCAC) of CMA CGM at ShipsGo.
# AGG_SCAC_CMA=CMDU

# Carrier code of Grimaldi at ShipsGo (unverified: `eta probe aggregator` lists the active codes).
# AGG_SCAC_GRIMALDI=GRIU


# =============================================================================================================
# Obsolete variables of the old tool (02 sec. 3): delete QB, QB_HEADLESS, HOME_PAGE, LOGIN_URL and MSC_PASSWORD
# from your old .env. They are ignored, because nothing signs in through a browser any more.
# =============================================================================================================
